# SendGrid MCP Server Configuration
# Copy this file to .env and fill in your actual values

# SendGrid API Key (Required)
# Get this from: https://app.sendgrid.com/settings/api_keys
# Format: SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Optional: Server Configuration
# MCP_SERVER_NAME=sendgrid-mcp
# MCP_SERVER_VERSION=1.0.0

# Optional: Logging Level
# LOG_LEVEL=info

# Optional: Request Timeout (in milliseconds)
# REQUEST_TIMEOUT=30000

# Optional: Read-Only Mode (Default: true)
# When true, only non-mutating operations are available (list, get, search, open)
# Set to false to enable create, update, delete, and send operations
# READ_ONLY=true

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# "stdio"  (default) - for Claude Desktop and Claude Code (local subprocess)
# "http"             - Streamable HTTP, for remote MCP connectors and OpenAI
# MCP_TRANSPORT=stdio

# --- The following only apply when MCP_TRANSPORT=http ---

# Port and bind address for the HTTP transport.
# Keep the host on 127.0.0.1 unless you intend to expose the server.
# PORT=3000
# MCP_HTTP_HOST=127.0.0.1

# Externally reachable base URL. Required when running behind a proxy, since
# the server cannot otherwise know its own public origin. Must be https://
# unless it points at loopback.
# MCP_PUBLIC_URL=https://mcp.example.com

# ---------------------------------------------------------------------------
# Authentication (MCP_TRANSPORT=http)
# ---------------------------------------------------------------------------
# "oauth" - verify tokens issued by your identity provider (recommended)
# "token" - single shared secret, good for local dev / simple self-hosting
# "none"  - no auth; the server refuses to start this way on a public bind
# MCP_AUTH_MODE=token

# --- MCP_AUTH_MODE=token ---
# Generate one with: openssl rand -hex 32   (minimum 16 characters)
# MCP_AUTH_TOKEN=

# --- MCP_AUTH_MODE=oauth ---
# Issuer URL of your authorization server.
# MCP_OAUTH_ISSUER=https://your-tenant.auth0.com
# This server's resource identifier; must equal the token's `aud` claim.
# Defaults to MCP_PUBLIC_URL when unset.
# MCP_OAUTH_AUDIENCE=https://mcp.example.com
# Defaults to <issuer>/.well-known/jwks.json; override for non-standard IdPs.
# MCP_OAUTH_JWKS_URI=
# Scopes a token must carry to reach /mcp. Space- or comma-separated.
# MCP_OAUTH_REQUIRED_SCOPES=sendgrid:read

# ---------------------------------------------------------------------------
# TLS (MCP_TRANSPORT=http)
# ---------------------------------------------------------------------------
# Set both to terminate HTTPS in-process. Leave unset if a proxy or load
# balancer already terminates TLS, and set TRUST_PROXY=true instead.
# TLS_KEY_FILE=/etc/ssl/private/mcp.key
# TLS_CERT_FILE=/etc/ssl/certs/mcp.crt
# Optional CA bundle for intermediate certificate chains.
# TLS_CA_FILE=

# Trust X-Forwarded-* headers. Enable ONLY behind a proxy you control --
# these headers are client-controlled otherwise.
# TRUST_PROXY=false

# DNS-rebinding protection. Comma-separated allowlists; when either is set,
# protection is enabled and non-matching Host/Origin headers are rejected.
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://claude.ai
