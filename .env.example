# SendGrid MCP Server Configuration
# Copy this file to .env and fill in your actual values

# SendGrid API Key (Required)
# Get this from: https://app.sendgrid.com/settings/api_keys
# Format: SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Optional: Server Configuration
# MCP_SERVER_NAME=sendgrid-mcp
# MCP_SERVER_VERSION=1.0.0

# Optional: Logging Level
# LOG_LEVEL=info

# Optional: Request Timeout (in milliseconds)
# REQUEST_TIMEOUT=30000

# Optional: Read-Only Mode (Default: true)
# When true, only non-mutating operations are available (list, get, search, open)
# Set to false to enable create, update, delete, and send operations
# READ_ONLY=true

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# "stdio"  (default) - for Claude Desktop and Claude Code (local subprocess)
# "http"             - Streamable HTTP, for remote MCP connectors and OpenAI
# MCP_TRANSPORT=stdio

# --- The following only apply when MCP_TRANSPORT=http ---

# Port and bind address for the HTTP transport.
# Keep the host on 127.0.0.1 unless you intend to expose the server.
# PORT=3000
# MCP_HTTP_HOST=127.0.0.1

# Bearer token required on every request to /mcp.
# REQUIRED in practice for any non-localhost deployment: without it, anyone who
# can reach the port can send email through your SendGrid account.
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# DNS-rebinding protection. Comma-separated allowlists; when either is set,
# protection is enabled and non-matching Host/Origin headers are rejected.
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://claude.ai
